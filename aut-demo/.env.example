# Copy this file to .env (same directory as docker-compose.yml) and fill in real values.
# .env is gitignored and must never be committed.

MYSQL_ROOT_PASSWORD=changeme-root-password
MYSQL_DATABASE=taskflow
MYSQL_USER=taskflow
MYSQL_PASSWORD=changeme-dev-password

# Host port to map container 3306 to. Change this if port 3306 is already used by another
# local MySQL instance (common on dev machines) - the container's internal port stays 3306.
MYSQL_HOST_PORT=3306
