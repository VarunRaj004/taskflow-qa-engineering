# Copy this file to .env and fill in real values for your local environment.
# .env is gitignored and must never be committed.

# JWT signing secret (HS256). The dev profile falls back to an insecure placeholder if this is
# unset, but that fallback is for local convenience only - any CI or shared environment must
# set a real secret here.
JWT_SECRET=changeme-dev-secret-do-not-use-in-prod

# MySQL connection (used by the "dev" and "docker" Spring profiles; see ../docker-compose.yml
# for a local MySQL instance that matches these defaults).
DB_HOST=localhost
DB_PORT=3306
DB_NAME=taskflow
DB_USER=taskflow
DB_PASSWORD=changeme-dev-password

# Port the backend itself listens on.
SERVER_PORT=8080

# Comma-separated list of origins allowed to call the API cross-origin (the frontend's dev
# server origin by default). Add a deployed frontend's origin here if you host it elsewhere.
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
