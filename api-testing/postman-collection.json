    {
      "name": "2. Tasks",
      "item": [
        {
          "name": "Create task - minimal (title only)",
          "event": [ { "listen": "test", "script": { "type": "text/javascript", "exec": [
            "pm.test('Status 201', () => pm.response.to.have.status(201));",
            "const body = pm.response.json();",
            "pm.test('Defaults applied: TODO / MEDIUM', () => { pm.expect(body.status).to.eql('TODO'); pm.expect(body.priority).to.eql('MEDIUM'); });",
            "pm.test('Owned by the authenticated user', () => pm.expect(String(body.ownerId)).to.eql(String(pm.environment.get('userAId'))));",
            "pm.environment.set('lastTaskId', body.id);"
          ] } } ],
          "request": {
            "method": "POST",
            "header": [ { "key": "Content-Type", "value": "application/json" }, { "key": "Authorization", "value": "Bearer {{userAToken}}" } ],
            "body": { "mode": "raw", "raw": "{\n  \"title\": \"Buy groceries\"\n}" },
            "url": { "raw": "{{baseUrl}}/api/tasks", "host": ["{{baseUrl}}"], "path": ["api", "tasks"] }
          }
        },
        {
          "name": "Create task - full fields",
          "event": [ { "listen": "test", "script": { "type": "text/javascript", "exec": [
            "pm.test('Status 201', () => pm.response.to.have.status(201));",
            "const body = pm.response.json();",
            "pm.test('Fields echoed as submitted', () => { pm.expect(body.status).to.eql('IN_PROGRESS'); pm.expect(body.priority).to.eql('HIGH'); pm.expect(body.title).to.eql('Write QA report'); });",
            "pm.environment.set('secondTaskId', body.id);"
          ] } } ],
          "request": {
            "method": "POST",
            "header": [ { "key": "Content-Type", "value": "application/json" }, { "key": "Authorization", "value": "Bearer {{userAToken}}" } ],
            "body": { "mode": "raw", "raw": "{\n  \"title\": \"Write QA report\",\n  \"description\": \"Cover auth, tasks and access control\",\n  \"status\": \"IN_PROGRESS\",\n  \"priority\": \"HIGH\"\n}" },
            "url": { "raw": "{{baseUrl}}/api/tasks", "host": ["{{baseUrl}}"], "path": ["api", "tasks"] }
          }
        },
        {
          "name": "Create task - to be deleted later",
          "event": [ { "listen": "test", "script": { "type": "text/javascript", "exec": [
