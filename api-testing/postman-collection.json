          ] } } ],
          "request": {
            "method": "GET",
            "header": [ { "key": "Authorization", "value": "Bearer {{userAToken}}" } ],
            "url": { "raw": "{{baseUrl}}/api/tasks?priority=HIGH", "host": ["{{baseUrl}}"], "path": ["api", "tasks"], "query": [ { "key": "priority", "value": "HIGH" } ] }
          }
        },
        {
          "name": "List tasks - search is case-insensitive per REQ-TASK-007 (uppercase term)",
          "event": [ { "listen": "test", "script": { "type": "text/javascript", "exec": [
            "pm.test('Status 200', () => pm.response.to.have.status(200));",
            "const body = pm.response.json();",
            "pm.test('REQ-TASK-007: an uppercase search term still matches the lowercase \\'groceries\\' task title', () => pm.expect(body.tasks.some(t => t.title === 'Buy groceries')).to.be.true);"
          ] } } ],
          "request": {
            "method": "GET",
            "header": [ { "key": "Authorization", "value": "Bearer {{userAToken}}" } ],
            "url": { "raw": "{{baseUrl}}/api/tasks?search=GROCERIES", "host": ["{{baseUrl}}"], "path": ["api", "tasks"], "query": [ { "key": "search", "value": "GROCERIES" } ] }
          }
        },
        {
          "name": "List tasks - sort by title ascending",
          "event": [ { "listen": "test", "script": { "type": "text/javascript", "exec": [
            "pm.test('Status 200', () => pm.response.to.have.status(200));",
            "const titles = pm.response.json().tasks.map(t => t.title);",
            "const sorted = [...titles].sort((a, b) => a.localeCompare(b));",
            "pm.test('Tasks are sorted by title ascending', () => pm.expect(titles).to.eql(sorted));"
          ] } } ],
          "request": {
            "method": "GET",
            "header": [ { "key": "Authorization", "value": "Bearer {{userAToken}}" } ],
            "url": { "raw": "{{baseUrl}}/api/tasks?sortBy=title&sortDir=asc", "host": ["{{baseUrl}}"], "path": ["api", "tasks"], "query": [ { "key": "sortBy", "value": "title" }, { "key": "sortDir", "value": "asc" } ] }
          }
