      "name": "4. Access control (cross-user ownership)",
      "item": [
        {
          "name": "Create task as User B (for isolation checks)",
          "event": [ { "listen": "test", "script": { "type": "text/javascript", "exec": [
            "pm.test('Status 201', () => pm.response.to.have.status(201));",
            "pm.environment.set('userBTaskId', pm.response.json().id);"
          ] } } ],
          "request": {
            "method": "POST",
            "header": [ { "key": "Content-Type", "value": "application/json" }, { "key": "Authorization", "value": "Bearer {{userBToken}}" } ],
            "body": { "mode": "raw", "raw": "{\n  \"title\": \"User B's private task\"\n}" },
            "url": { "raw": "{{baseUrl}}/api/tasks", "host": ["{{baseUrl}}"], "path": ["api", "tasks"] }
          }
        },
        {
          "name": "List tasks as User A - must not include User B's task",
          "event": [ { "listen": "test", "script": { "type": "text/javascript", "exec": [
            "pm.test('Status 200', () => pm.response.to.have.status(200));",
            "const ids = pm.response.json().tasks.map(t => String(t.id));",
            "pm.test('REQ-ACCESS-001: User B\\'s task id is absent from User A\\'s list', () => pm.expect(ids).to.not.include(String(pm.environment.get('userBTaskId'))));"
          ] } } ],
          "request": {
            "method": "GET",
            "header": [ { "key": "Authorization", "value": "Bearer {{userAToken}}" } ],
            "url": { "raw": "{{baseUrl}}/api/tasks", "host": ["{{baseUrl}}"], "path": ["api", "tasks"] }
          }
        },
        {
          "name": "User A GET User B's task by id (expect 404, not 403)",
          "event": [ { "listen": "test", "script": { "type": "text/javascript", "exec": [
            "pm.test('REQ-ACCESS-002: 404, identical to a non-existent id', () => pm.response.to.have.status(404));"
          ] } } ],
          "request": {
            "method": "GET",
            "header": [ { "key": "Authorization", "value": "Bearer {{userAToken}}" } ],
            "url": { "raw": "{{baseUrl}}/api/tasks/{{userBTaskId}}", "host": ["{{baseUrl}}"], "path": ["api", "tasks", "{{userBTaskId}}"] }
          }
        },
        {
          "name": "User A UPDATE User B's task (expect 404)",
          "event": [ { "listen": "test", "script": { "type": "text/javascript", "exec": [
            "pm.test('REQ-ACCESS-003: 404', () => pm.response.to.have.status(404));"
          ] } } ],
          "request": {
            "method": "PUT",
            "header": [ { "key": "Content-Type", "value": "application/json" }, { "key": "Authorization", "value": "Bearer {{userAToken}}" } ],
            "body": { "mode": "raw", "raw": "{\n  \"status\": \"DONE\"\n}" },
            "url": { "raw": "{{baseUrl}}/api/tasks/{{userBTaskId}}", "host": ["{{baseUrl}}"], "path": ["api", "tasks", "{{userBTaskId}}"] }
          }
        },
        {
          "name": "User A DELETE User B's task (expect 404)",
          "event": [ { "listen": "test", "script": { "type": "text/javascript", "exec": [
            "pm.test('REQ-ACCESS-003: 404', () => pm.response.to.have.status(404));"
          ] } } ],
          "request": {
            "method": "DELETE",
            "header": [ { "key": "Authorization", "value": "Bearer {{userAToken}}" } ],
            "url": { "raw": "{{baseUrl}}/api/tasks/{{userBTaskId}}", "host": ["{{baseUrl}}"], "path": ["api", "tasks", "{{userBTaskId}}"] }
          }
