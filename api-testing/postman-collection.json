{
  "info": {
    "_postman_id": "taskflow-qa-collection",
    "name": "TaskFlow QA - API tests",
    "description": "REST API tests for the TaskFlow demo AUT (aut-demo/), covering auth, task CRUD, filtering, ownership/access control and dashboard counts. Run with Newman: npx newman run api-testing/postman-collection.json -e api-testing/postman-environment.example.json",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "1. Auth",
      "item": [
        {
          "name": "Register - User A (valid)",
          "event": [
            { "listen": "prerequest", "script": { "type": "text/javascript", "exec": [
              "pm.environment.set('userAEmail', 'qa.alice+' + Date.now() + '@example.test');"
            ] } },
            { "listen": "test", "script": { "type": "text/javascript", "exec": [
              "pm.test('Status 201', () => pm.response.to.have.status(201));",
              "pm.test('Content-Type is JSON', () => pm.response.headers.get('Content-Type').includes('application/json'));",
              "const body = pm.response.json();",
              "pm.test('Response has id, name, email', () => { pm.expect(body).to.have.property('id'); pm.expect(body).to.have.property('name'); pm.expect(body).to.have.property('email'); });",
              "pm.test('Email echoes what was submitted', () => pm.expect(body.email.toLowerCase()).to.eql(pm.environment.get('userAEmail').toLowerCase()));",
              "pm.test('No password material in response', () => { pm.expect(body).to.not.have.property('password'); pm.expect(body).to.not.have.property('passwordHash'); });",
              "pm.test('Response time under threshold', () => pm.expect(pm.response.responseTime).to.be.below(Number(pm.environment.get('responseTimeThresholdMs'))));"
            ] } }
          ],
          "request": {
            "method": "POST",
            "header": [ { "key": "Content-Type", "value": "application/json" } ],
            "body": { "mode": "raw", "raw": "{\n  \"name\": \"QA Alice\",\n  \"email\": \"{{userAEmail}}\",\n  \"password\": \"{{userAPassword}}\"\n}" },
            "url": { "raw": "{{baseUrl}}/api/auth/register", "host": ["{{baseUrl}}"], "path": ["api", "auth", "register"] }
          }
        },
        {
          "name": "Register - User B (valid)",
